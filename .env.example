# Copia este archivo a `.env` (desarrollo y CLI) y carga las mismas variables en
# Vercel → Project → Settings → Environment Variables. Todas son SOLO servidor.
# La configuración de cada liga (asociación, liga, equipo propio, competición) NO va aquí:
# vive en la tabla courtrack_leagues y se gestiona desde el dashboard (Partidos → Ligas).

# ─── Supabase: la MISMA instancia que usa el dashboard (coyotes-website) ─────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta (sb_secret_...) o service_role. Ignora RLS: NUNCA exponer al cliente.
SUPABASE_SECRET_KEY=

# ─── Acceso al microservicio ─────────────────────────────────────────────────
# Quien llama a /api/sync y /api/courtrack/* envía `Authorization: Bearer <SYNC_SECRET>`. Sin él, 503.
# Genera una cadena larga (p.ej. `openssl rand -hex 32`) y ponla también en COURTRACK_SYNC_SECRET del dashboard.
SYNC_SECRET=

# ─── Límite de sincronizaciones ──────────────────────────────────────────────
# Máximo de syncs reales (sin dry_run) por organización en una ventana de 24 h, sumando todas sus ligas.
# Es el valor por defecto: una organización puede tener el suyo en organizations.courtrack_daily_limit.
SYNC_DAILY_LIMIT=5

# ─── CourtTrack ──────────────────────────────────────────────────────────────
# COURTRACK_BASE_URL=https://api.courtrack.com

# ─── Chequeo semanal del contrato (api/cron/contract-check.ts, viernes 12:00 UTC) ─
# Vercel Cron lo llama con `Authorization: Bearer <CRON_SECRET>` (Vercel lo inyecta si defines la variable). Genera una cadena larga.
CRON_SECRET=
# Aviso por email si el contrato falla (Resend, https://resend.com). Sin estas variables el cron solo registra el resultado.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=               # uno o varios, separados por coma
# ALERT_EMAIL_FROM=             # dominio verificado en Resend; por defecto onboarding@resend.dev (solo entrega al dueño de la cuenta)
