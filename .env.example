# Copia este archivo a `.env` (desarrollo y CLI) y carga las mismas variables en
# Vercel → Project → Settings → Environment Variables. Todas son SOLO servidor.

# ─── Supabase: la MISMA instancia que usa el dashboard (coyotes-website) ─────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta (sb_secret_...) o service_role. Ignora RLS: NUNCA exponer al cliente.
SUPABASE_SECRET_KEY=

# ─── Acceso al microservicio ─────────────────────────────────────────────────
# Quien llama a /api/sync envía `Authorization: Bearer <SYNC_SECRET>`. Sin él, el servicio responde 503.
# Genera una cadena larga (p.ej. `openssl rand -hex 32`) y ponla también en COURTRACK_SYNC_SECRET del dashboard.
SYNC_SECRET=

# ─── Límite de sincronizaciones ──────────────────────────────────────────────
# Máximo de syncs reales (sin dry_run) en una ventana de 24 h por organización. Se cuenta en la tabla sync_log.
SYNC_DAILY_LIMIT=3
# Identificador de la organización en sync_log (un solo equipo hoy; preparado para varios).
SYNC_ORG_ID=coyotes

# ─── CourtTrack (API pública de solo lectura de la app de PODIO) ─────────────
# COURTRACK_BASE_URL=https://api.courtrack.com
# Asociación en CourtTrack: PODIO = 5 (GET /api/torneo/getClientes).
COURTRACK_ID_CLIENTE=5
# Liga a importar (GET /api/torneo/getLigas?id_cliente=5). Cambia cada temporada:
# 605 = "+21 Disidencias - NIVEL B - Clausura 2026". El servicio resuelve solo sus torneos y etapas.
COURTRACK_LIGA_ID=605
# Nombre del equipo propio tal como aparece en CourtTrack (se compara sin acentos ni mayúsculas).
COURTRACK_TEAM=COYOTES
# Valor de `matches.competition` para los partidos importados (el dashboard ofrece "Liga Podio" y "Amistoso").
COURTRACK_COMPETITION=Liga Podio
# Opcional: alias JSON para unir nombres de CourtTrack con rivales ya cargados en el dashboard.
# Sin alias, se busca por nombre normalizado ("ONAS" = "Onas") y si no existe se crea el rival.
# Los rivales de la Clausura 2026 ya cargados a mano usan estos nombres:
COURTRACK_TEAM_ALIASES={"DRAGONXS HIELO":"Dragons de Hielo","ONAS":"Las Onas","TITANES VOLEY":"Titanes"}
